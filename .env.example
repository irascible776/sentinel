# ==============================================================================
# AI Security Gateway - Unified Configuration & Credentials
# DTU B.Tech Minor Project (IT401) | Group 138
# ==============================================================================

# --- Gateway Network Configuration (Developer 2: Rupesh) ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_DEBUG=True
GATEWAY_ADMIN_KEY=gw-admin-secret-key-dtu138

# --- Upstream LLM Configuration (Developer 2: Rupesh) ---
# Options: "gemini" (Google Gemini API), "mock" (offline test/demo mode), "openai", or "ollama"
UPSTREAM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Fallback / Alternative Providers
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_API_KEY=
UPSTREAM_MODEL=gemini-1.5-flash

# --- ML & Detection Engine Configuration (Developer 1: Rohit) ---
HF_MODEL_NAME=protectai/deberta-v3-base-prompt-injection-v2
DETECTION_DEVICE=auto
SLIDING_WINDOW_MINUTES=10
THREAT_RULES_PATH=core/detection/threat_rules.json

# --- Stage 2 Arbiter (Local GGUF — M1 Air) ---
# Download GGUF model first: python scripts/download_models.py --arbiter-lite
# Then set the path below. Leave blank to use Groq API or Gemini as fallback.
ARBITER_GGUF_PATH=models/arbiter_gguf/Llama-3.2-1B-Instruct-Q4_K_M.gguf
ARBITER_BACKEND=auto
# Optional Groq cloud fallback (if no GGUF): https://console.groq.com/keys
GROQ_API_KEY=

# --- Channel B Intent Classifier (optional fine-tuned model) ---
INTENT_MODEL_PATH=

# --- Pillar III: Vision & Document Threat Engine (Developer 3: Utkarsh) ---
# OCR Backend: "auto" (probes EasyOCR -> Tesseract -> Mock), "easyocr", "tesseract", or "mock"
VISION_OCR_BACKEND=auto
# Execution device: "auto" (Metal GPU 'mps' on M1 Air, 'cuda' on Nvidia, 'cpu' fallback)
VISION_DEVICE=auto
# Enable localized solid charcoal masking for policy REDACT_IMAGE
VISION_ALLOW_REDACTION=True

# --- Security Vectors & Canary Configuration (Developer 3: Utkarsh) ---
CANARY_TOKEN_PREFIX=CANARY-SECRET-
REDTEAM_SERVICE_KEY=your-secret-redteam-service-key-here
DATABASE_URL=sqlite:///./gateway.db
DASHBOARD_PORT=8501
AUDIO_SAMPLE_RATE=16000
