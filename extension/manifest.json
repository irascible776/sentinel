{
  "manifest_version": 3,
  "name": "DTU AI Security Gateway",
  "version": "1.0.0",
  "description": "Real-time prompt injection defense for ChatGPT, Claude, and Web AI.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "file://*/*demo_chat_client.html*",
        "http://*/*demo_chat_client.html*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DTU AI Security Gateway"
  }
}
