{
  "version": "1.4.0",
  "updated_at": "2026-10-28T06:00:00.000000+00:00",
  "rules": [
    {
      "id": "MAL-001",
      "name": "Malware & Spyware Code Request",
      "description": "Detects requests to write keyloggers, spyware, stalkerware, or credential-stealing software.",
      "category": "APPLICATION_PLANE_ABUSE",
      "pattern": "(?i)\\b(write|create|build|code|make|develop|generate|implement|script)\\b.{0,60}\\b(key\\s*logger|key\\s*logging|keystroke\\s*(logger|capture|recorder)|key\\s*capture|keyboard\\s*(hook|spy|logger)|spyware|stalkerware|screen\\s*(grabber|capture\\s*malware)|credential\\s*(stealer|harvester))\\b",
      "severity": "CRITICAL",
      "weight": 97
    },
    {
      "id": "MAL-002",
      "name": "Ransomware & Malware Dropper Request",
      "description": "Detects requests to write ransomware, trojans, rootkits, malware droppers, or C2 beacons.",
      "category": "APPLICATION_PLANE_ABUSE",
      "pattern": "(?i)\\b(write|create|build|code|make|develop|generate|implement|script)\\b.{0,60}\\b(ransomware|ransom\\s+note\\s+encryptor|file\\s+encryptor.{0,20}ransom|trojan|rootkit|bootkit|malware\\s+(dropper|loader|stager)|c2\\s+beacon|command.{0,5}control\\s+beacon|backdoor.{0,30}malware|rat\\s+(payload|client))\\b",
      "severity": "CRITICAL",
      "weight": 97
    },
    {
      "id": "SOC-001",
      "name": "Phishing & Social Engineering Asset Request",
      "description": "Detects requests to create phishing pages, credential harvesting forms, or social engineering email templates.",
      "category": "APPLICATION_PLANE_ABUSE",
      "pattern": "(?i)\\b(write|create|build|make|generate|craft|design)\\b.{0,80}\\b(phishing\\s+(email|page|site|template|kit|link)|credential\\s+(harvester|stealer|harvesting\\s+form|capture\\s+page)|fake\\s+(login\\s+page|bank\\s+page|paypal|microsoft|google)\\s+(clone|replica)|spear\\s+phishing|smishing\\s+template|vishing\\s+script)\\b",
      "severity": "CRITICAL",
      "weight": 95
    },
    {
      "id": "EXP-001",
      "name": "Exploit & Remote Access Weapon Request",
      "description": "Detects requests to create reverse shells, exploit code, privilege escalation scripts, or network attack tools.",
      "category": "APPLICATION_PLANE_ABUSE",
      "pattern": "(?i)\\b(write|create|build|code|make|generate|implement|script|give\\s+me)\\b.{0,80}\\b(reverse\\s+shell|bind\\s+shell|meterpreter\\s+(payload|stager)|exploit\\s+(for|targeting)\\s+CVE|privilege\\s+escalation\\s+(script|exploit)|buffer\\s+overflow\\s+exploit|shellcode\\s+(for|targeting)|remote\\s+code\\s+execution\\s+exploit|sql\\s+injection\\s+(payload|exploit)|xss\\s+payload.{0,20}steal|ddos\\s+(tool|script|bot)|syn\\s+flood\\s+(script|tool))\\b",
      "severity": "CRITICAL",
      "weight": 95
    },
    {
      "id": "SIG-001",
      "name": "Direct Instruction Override",
      "pattern": "(?i)(ignore|disregard|forget|override)\\s+(all\\s+)?(previous|prior|system|internal)?\\s*(instructions|rules|guidelines|directives)",
      "severity": "HIGH",
      "weight": 100
    },
    {
      "id": "SIG-002",
      "name": "DAN Persona & Developer Mode Jailbreak",
      "pattern": "(?i)(you\\s+are\\s+now\\s+(DAN|EvilBot|AIM)|do\\s+anything\\s+now|\\b(in|enter|enable|switch\\s+to|activate|turn\\s+on)\\s+developer\\s+mode\\b|developer\\s+mode\\s*:\\s*(enabled|true)|jailbreak\\s+mode|uncensored\\s+mode|safety\\s+guardrails?\\s+(are\\s+)?disabled)",
      "severity": "HIGH",
      "weight": 95
    },
    {
      "id": "SIG-003",
      "name": "System Prompt Extraction",
      "pattern": "(?i)(repeat\\s+the\\s+words\\s+above|print\\s+(?:the\\s+)?(?:initial|confidential)?\\s*system\\s+prompt|what\\s+are\\s+your\\s+instructions|system\\s+prompt\\s+header|first\\s+directive\\s+given\\s+to\\s+you)",
      "severity": "MEDIUM",
      "weight": 80
    },
    {
      "id": "SIG-004",
      "name": "Roleplay & Penetration Tester Simulation",
      "pattern": "(?i)(pretend\\s+to\\s+be(\\s+an?\\s+unfiltered)?|simulate\\s+(a|an)?\\s*(terminal|environment|simulation)|in\\s+a\\s+fictional\\s+simulation|with\\s+no\\s+safety\\s+(guidelines|protocols|rules)|roleplaying\\s+as(\\s+a\\s+jailbroken)?|penetration\\s+tester\\b)",
      "severity": "MEDIUM",
      "weight": 75
    },
    {
      "id": "SIG-005",
      "name": "Delimiter Instruction Injection",
      "pattern": "(?i)(###\\s*instruction\\s*override|system\\s*override\\s*:|---+\\s*new\\s+instruction)",
      "severity": "HIGH",
      "weight": 90
    },
    {
      "id": "SIG-006",
      "name": "Canary & Secret Key Harvesting",
      "pattern": "(?i)(secret\\s+canary\\s+token|reveal\\s+confidential\\s+key|dump\\s+canary|master\\s+api\\s+keys)",
      "severity": "HIGH",
      "weight": 85
    },
    {
      "id": "SIG-007",
      "name": "Direct Jailbreak & Intent Action",
      "pattern": "(?i)\\b(jail\\s*-?\\s*break|bypass|override|disable|unlock|defeat|circumvent)\\b.{0,40}\\b(source\\s*code|system\\s*prompt|instructions?|guardrails?|safety|filters?|restrictions?|rules|polic(?:y|ies)|code)\\b",
      "severity": "HIGH",
      "weight": 85
    },
    {
      "id": "SIG-008",
      "name": "Direct Target Extraction",
      "pattern": "(?i)\\b(reveal|leak|dump|print|show|expose|extract|give\\s+me)\\b.{0,30}\\b(your|the|ur)\\b.{0,20}\\b(system\\s*prompt|hidden\\s*prompt|instructions?|source\\s*code)\\b",
      "severity": "HIGH",
      "weight": 80
    },
    {
      "id": "SIG-009",
      "name": "Jailbreak Term Tripwire",
      "pattern": "(?i)\\b(jail\\s*-?\\s*break(?:ing|er|ed|s)?|dan\\s+mode|developer\\s+mode)\\b",
      "severity": "MEDIUM",
      "weight": 60
    },
